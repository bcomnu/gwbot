# ============================================================
# Telegram Giveaway Bot - Environment Configuration
# Copy this file to `.env` and fill in your real values.
# ============================================================

# --- Telegram ---
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=8547742832:AAH4EXid9tgmm0ZLDQq7j2c6cJF3JpCqCBs

# Comma-separated Telegram user IDs that are super-admins (full access).
# Find your ID via @userinfobot
SUPER_ADMIN_IDS=5343809391

# Optional: username of the bot (without @) used to build referral deep links
BOT_USERNAME=MyGiveawayBot

# --- Database (PostgreSQL) ---
# Full SQLAlchemy database URL. Use postgresql+psycopg2 driver.
DATABASE_URL=postgresql+psycopg2://giveaway:giveaway@localhost:5432/giveaway_bot

# --- Localization ---
DEFAULT_LANGUAGE=en

# --- Behavior / Limits ---
# Global default: max entries a user may create per giveaway
DEFAULT_ENTRY_LIMIT_PER_USER=1
# Rate limiting: max actions per user per minute
RATE_LIMIT_PER_MINUTE=20
# Minimum Telegram account age (in days) required to enter (0 = disabled)
MIN_ACCOUNT_AGE_DAYS=0
# Timezone for scheduling & display
TIMEZONE=UTC

# --- Anti-cheat ---
# Enable duplicate account heuristics
ENABLE_DUPLICATE_DETECTION=true
# Enable bot-account filtering
ENABLE_BOT_FILTERING=true

# --- Social verification (optional, for follow verification) ---
# Twitter/X bearer token for follow checks (leave empty to use manual/honor mode)
TWITTER_BEARER_TOKEN=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
